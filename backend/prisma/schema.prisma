generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  PLANNING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  BOOKED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  OTHER
}

enum RecipientType {
  TOURIST
  GUIDE
  VRSP
}

enum NotificationType {
  BOOKING_UPDATE
  PAYMENT_UPDATE
  TRIP_UPDATE
  REVIEW_REPLY
  SYSTEM
}

model Tourist {
  touristId      String   @id @default(cuid()) @map("tourist_id")
  fullName       String   @map("full_name")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  phone          String?
  profilePicture String?  @map("profile_picture")
  createdAt      DateTime @default(now()) @map("created_at")

  trips            Trip[]
  locationReviews  LocationReview[]
  guideReviews     GuideReview[]
  vrspReviews      VRSPReview[]
  payments         Payment[]
  vehicleBookings  VehicleRentalBooking[]

  @@map("tourists")
}

model Category {
  categoryId String @id @default(cuid()) @map("category_id")
  name       String @unique

  trips     Trip[]
  locations LocationCategory[]

  @@map("categories")
}

model Location {
  locationId  String  @id @default(cuid()) @map("location_id")
  name        String
  description String?
  avgStayDays Decimal? @db.Decimal(5, 2) @map("avg_stay_days")
  imageUrl    String? @map("image_url")
  videoUrl    String? @map("video_url")

  categories LocationCategory[]
  tripStops  TripLocation[]
  reviews    LocationReview[]

  @@index([name])
  @@map("locations")
}

model LocationCategory {
  locationId String @map("location_id")
  categoryId String @map("category_id")

  location Location @relation(fields: [locationId], references: [locationId], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)

  @@id([locationId, categoryId])
  @@index([categoryId])
  @@map("location_categories")
}

model Trip {
  tripId                String     @id @default(cuid()) @map("trip_id")
  touristId             String     @map("tourist_id")
  categoryId            String     @map("category_id")
  startDate             DateTime?  @db.Date @map("start_date")
  endDate               DateTime?  @db.Date @map("end_date")
  numAdults             Int        @default(1) @map("num_adults")
  numChildren           Int        @default(0) @map("num_children")
  numPets               Int        @default(0) @map("num_pets")
  preferredTravelMethod String?    @map("preferred_travel_method")
  mainRoadsOnly         Boolean    @default(false) @map("main_roads_only")
  status                TripStatus @default(PLANNING)
  createdAt             DateTime   @default(now()) @map("created_at")

  tourist              Tourist               @relation(fields: [touristId], references: [touristId])
  category             Category              @relation(fields: [categoryId], references: [categoryId])
  locations            TripLocation[]
  guideBookings        GuideBooking[]
  vehicleRentalBooking VehicleRentalBooking?

  @@index([touristId, createdAt])
  @@index([status])
  @@map("trips")
}

model TripLocation {
  tripLocationId String @id @default(cuid()) @map("trip_location_id")
  tripId         String @map("trip_id")
  locationId     String @map("location_id")
  dayAllocated   Int?   @map("day_allocated")
  visitOrder     Int    @default(1) @map("visit_order")

  trip     Trip     @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [locationId])
  reviews  LocationReview[]

  @@unique([tripId, visitOrder])
  @@index([locationId])
  @@map("trip_locations")
}

model LocationReview {
  reviewId       String   @id @default(cuid()) @map("review_id")
  touristId      String   @map("tourist_id")
  locationId     String   @map("location_id")
  tripLocationId String?  @map("trip_location_id")
  rating         Int
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")

  tourist      Tourist       @relation(fields: [touristId], references: [touristId])
  location     Location      @relation(fields: [locationId], references: [locationId])
  tripLocation TripLocation? @relation(fields: [tripLocationId], references: [tripLocationId])

  @@index([locationId, createdAt])
  @@map("location_reviews")
}

model Guide {
  guideId          String   @id @default(cuid()) @map("guide_id")
  fullName         String   @map("full_name")
  email            String   @unique
  passwordHash     String   @map("password_hash")
  phone            String?
  profilePicture   String?  @map("profile_picture")
  nic              String?  @unique
  govtGuideId      String?  @map("govt_guide_id")
  address          String?
  religion         String?
  citizenship      String?
  experienceYears  Int?     @map("experience_years")
  workSchedulePref String?  @map("work_schedule_pref")
  isVerified       Boolean  @default(false) @map("is_verified")
  createdAt        DateTime @default(now()) @map("created_at")

  reviews      GuideReview[]
  availability GuideAvailability[]
  bankAccount  GuideBankAccount?
  documents    GuideDocument[]
  vehicles     GuideVehicle[]
  languages    GuideLanguage[]
  bookings     GuideBooking[]

  @@map("guides")
}

model GuideReview {
  reviewId       String    @id @default(cuid()) @map("review_id")
  touristId      String    @map("tourist_id")
  guideId        String    @map("guide_id")
  guideBookingId String?   @map("guide_booking_id")
  rating         Int
  comment        String?
  replyText      String?   @map("reply_text")
  repliedAt      DateTime? @map("replied_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tourist      Tourist       @relation(fields: [touristId], references: [touristId])
  guide        Guide         @relation(fields: [guideId], references: [guideId])
  guideBooking GuideBooking? @relation(fields: [guideBookingId], references: [guideBookingId])

  @@index([guideId, createdAt])
  @@map("guide_reviews")
}

model GuideAvailability {
  availabilityId String             @id @default(cuid()) @map("availability_id")
  guideId        String             @map("guide_id")
  date           DateTime           @db.Date
  status         AvailabilityStatus @default(AVAILABLE)

  guide Guide @relation(fields: [guideId], references: [guideId], onDelete: Cascade)

  @@unique([guideId, date])
  @@map("guide_availability")
}

model GuideBankAccount {
  bankAccountId     String @id @default(cuid()) @map("bank_account_id")
  guideId           String @unique @map("guide_id")
  bankName          String @map("bank_name")
  branch            String?
  accountHolderName String @map("account_holder_name")
  accountNo         String @map("account_no")

  guide Guide @relation(fields: [guideId], references: [guideId], onDelete: Cascade)

  @@map("guide_bank_accounts")
}

model GuideDocument {
  documentId String   @id @default(cuid()) @map("document_id")
  guideId    String   @map("guide_id")
  docType    String   @map("doc_type")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  guide Guide @relation(fields: [guideId], references: [guideId], onDelete: Cascade)

  @@index([guideId])
  @@map("guide_documents")
}

model GuideVehicle {
  guideVehicleId  String  @id @default(cuid()) @map("guide_vehicle_id")
  guideId         String  @map("guide_id")
  vehicleType     String  @map("vehicle_type")
  vehicleNo       String  @map("vehicle_no")
  drivingLicenceNo String? @map("driving_licence_no")
  vehiclePhoto    String? @map("vehicle_photo")
  registrationDoc String? @map("registration_doc")

  guide    Guide          @relation(fields: [guideId], references: [guideId], onDelete: Cascade)
  bookings GuideBooking[]

  @@index([guideId])
  @@map("guide_vehicles")
}

model GuideLanguage {
  guideId    String @map("guide_id")
  languageId String @map("language_id")

  guide    Guide    @relation(fields: [guideId], references: [guideId], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [languageId], onDelete: Cascade)

  @@id([guideId, languageId])
  @@map("guide_languages")
}

model GuideBooking {
  guideBookingId String        @id @default(cuid()) @map("guide_booking_id")
  tripId         String        @map("trip_id")
  guideId        String        @map("guide_id")
  guideVehicleId String?       @map("guide_vehicle_id")
  timeRangeType  String?       @map("time_range_type")
  transportMode  String?       @map("transport_mode")
  driverType     String?       @map("driver_type")
  startDate      DateTime      @db.Date @map("start_date")
  endDate        DateTime      @db.Date @map("end_date")
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at")

  trip    Trip          @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  guide   Guide         @relation(fields: [guideId], references: [guideId])
  vehicle GuideVehicle? @relation(fields: [guideVehicleId], references: [guideVehicleId])
  reviews GuideReview[]
  payment Payment?

  @@index([guideId, startDate, endDate])
  @@index([tripId])
  @@map("guide_bookings")
}

model VRSP {
  vrspId          String   @id @default(cuid()) @map("vrsp_id")
  businessName    String   @map("business_name")
  email           String   @unique
  passwordHash    String   @map("password_hash")
  phone           String?
  profilePicture  String?  @map("profile_picture")
  nic             String?  @unique
  businessRegNo   String?  @map("business_reg_no")
  location        String?
  citizenship     String?
  experienceYears Int?     @map("experience_years")
  isVerified      Boolean  @default(false) @map("is_verified")
  createdAt       DateTime @default(now()) @map("created_at")

  reviews     VRSPReview[]
  vehicles    VRSPVehicle[]
  bankAccount VRSPBankAccount?
  documents   VRSPDocument[]
  languages   VRSPLanguage[]

  @@map("vehicle_rental_service_providers")
}

model VRSPReview {
  reviewId        String    @id @default(cuid()) @map("review_id")
  touristId       String    @map("tourist_id")
  vrspId          String    @map("vrsp_id")
  rentalBookingId String?   @map("rental_booking_id")
  rating          Int
  comment         String?
  replyText       String?   @map("reply_text")
  repliedAt       DateTime? @map("replied_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tourist       Tourist              @relation(fields: [touristId], references: [touristId])
  provider      VRSP                 @relation(fields: [vrspId], references: [vrspId])
  rentalBooking VehicleRentalBooking? @relation(fields: [rentalBookingId], references: [rentalBookingId])

  @@index([vrspId, createdAt])
  @@map("vrsp_reviews")
}

model VRSPVehicle {
  vrspVehicleId  String  @id @default(cuid()) @map("vrsp_vehicle_id")
  vrspId         String  @map("vrsp_id")
  vehicleType    String  @map("vehicle_type")
  vehicleNo      String  @map("vehicle_no")
  registrationDoc String? @map("registration_doc")
  insuranceDoc   String? @map("insurance_doc")
  isAvailable    Boolean @default(true) @map("is_available")

  provider VRSP                   @relation(fields: [vrspId], references: [vrspId], onDelete: Cascade)
  booking  VehicleRentalBooking?

  @@index([vrspId, isAvailable])
  @@map("vrsp_vehicles")
}

model VRSPBankAccount {
  bankAccountId     String @id @default(cuid()) @map("bank_account_id")
  vrspId            String @unique @map("vrsp_id")
  bankName          String @map("bank_name")
  branch            String?
  accountHolderName String @map("account_holder_name")
  accountNo         String @map("account_no")

  provider VRSP @relation(fields: [vrspId], references: [vrspId], onDelete: Cascade)

  @@map("vrsp_bank_accounts")
}

model VRSPDocument {
  documentId String   @id @default(cuid()) @map("document_id")
  vrspId     String   @map("vrsp_id")
  docType    String   @map("doc_type")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  provider VRSP @relation(fields: [vrspId], references: [vrspId], onDelete: Cascade)

  @@index([vrspId])
  @@map("vrsp_documents")
}

model VRSPLanguage {
  vrspId     String @map("vrsp_id")
  languageId String @map("language_id")

  provider VRSP     @relation(fields: [vrspId], references: [vrspId], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [languageId])

  @@id([vrspId, languageId])
  @@map("vrsp_languages")
}

model VehicleRentalBooking {
  rentalBookingId String        @id @default(cuid()) @map("rental_booking_id")
  tripId          String        @unique @map("trip_id")
  touristId       String        @map("tourist_id")
  vrspVehicleId   String        @unique @map("vrsp_vehicle_id")
  rentalType      String        @map("rental_type")
  pickupLocation  String        @map("pickup_location")
  dropoffLocation String        @map("dropoff_location")
  pickupDate      DateTime      @map("pickup_date")
  dropoffDate     DateTime      @map("dropoff_date")
  licenseVerified Boolean       @default(false) @map("license_verified")
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")

  trip    Trip        @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  tourist Tourist     @relation(fields: [touristId], references: [touristId])
  vehicle VRSPVehicle @relation(fields: [vrspVehicleId], references: [vrspVehicleId])
  reviews VRSPReview[]
  payment Payment?

  @@index([touristId, pickupDate])
  @@map("vehicle_rental_bookings")
}

model Payment {
  paymentId       String        @id @default(cuid()) @map("payment_id")
  touristId       String        @map("tourist_id")
  guideBookingId  String?       @unique @map("guide_booking_id")
  rentalBookingId String?       @unique @map("rental_booking_id")
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("LKR")
  paymentMethod   PaymentMethod @map("payment_method")
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?     @map("paid_at")

  tourist       Tourist                @relation(fields: [touristId], references: [touristId])
  guideBooking  GuideBooking?          @relation(fields: [guideBookingId], references: [guideBookingId])
  rentalBooking VehicleRentalBooking?  @relation(fields: [rentalBookingId], references: [rentalBookingId])

  @@index([touristId, status])
  @@map("payments")
}

model Language {
  languageId String @id @default(cuid()) @map("language_id")
  name       String @unique

  guides    GuideLanguage[]
  providers VRSPLanguage[]

  @@map("languages")
}

model Notification {
  notificationId String         @id @default(cuid()) @map("notification_id")
  recipientType  RecipientType  @map("recipient_type")
  recipientId    String         @map("recipient_id")
  type           NotificationType
  message        String
  isRead         Boolean        @default(false) @map("is_read")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([recipientType, recipientId, isRead, createdAt])
  @@map("notifications")
}